APP_NAME=BLUESKILLS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=blueskills
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@blueskills.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sail: host ports (5432/80 are often taken by a local Postgres / web server)
APP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=54320
FORWARD_REDIS_PORT=63790
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_MEILISEARCH_PORT=7700

# Meilisearch runs in Sail for Module 3 search; Scout is not installed yet
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_NO_ANALYTICS=true

# Data residency default for new users and organizations
BLUESKILLS_DEFAULT_DATA_REGION=ae

# First staff superuser (required in production; local falls back to superuser@blueskills.test / password)
BLUESKILLS_SUPERUSER_NAME="BLUESKILLS Superuser"
BLUESKILLS_SUPERUSER_EMAIL=
BLUESKILLS_SUPERUSER_PASSWORD=
BLUESKILLS_PRIVATE_DISK=private

# Worker sign-in codes: log (local, code appears in storage/logs) or whatsapp
OTP_CHANNEL=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=blueskills_login_code
WHATSAPP_API_VERSION=v23.0

# Voice-to-CV speech-to-text: sample (local, returns the prototype's answers) or none (typing only)
SPEECH_TO_TEXT_DRIVER=sample

# Staff 2FA is enforced by default; only disable on a local machine
BLUESKILLS_ENFORCE_STAFF_2FA=true

# Live messages and notifications (Module 5, D-067). Generate keys per environment.
# In Sail the app publishes to the `reverb` service; the browser connects to localhost:8081.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Alerts outside the app (Module 5, D-071): log locally; cloud / twilio in production.
NOTIFY_WHATSAPP_DRIVER=log
NOTIFY_SMS_DRIVER=log
WHATSAPP_UPDATE_TEMPLATE=blueskills_update
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SENDERS={}

# Security headers (D-105). The CSP is enforced when APP_ENV=production.
# BLUESKILLS_CSP_ENFORCE=
# BLUESKILLS_CSP_REPORT_URI=
# BLUESKILLS_CSP_MEDIA_SOURCES="https://files.example.com"
# BLUESKILLS_OTP_MAX_PER_IP_PER_HOUR=100
