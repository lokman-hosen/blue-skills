includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 6

    # Read Eloquent casts() so enum, state and date attributes get their real types.
    parseModelCastsMethod: true
